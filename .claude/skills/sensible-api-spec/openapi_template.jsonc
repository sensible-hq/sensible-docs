{
  // Always 3.0.3 — do not change.
  "openapi": "3.0.3",

  // Always this server and description — do not change.
  "servers": [
    {
      "url": "https://api.sensible.so/v0",
      "description": "Production server (uses live data)"
    }
  ],

  "info": {
    // Human-readable title matching the domain, e.g. "Email processors", "Configuration"
    "title": "{Domain name}",
    "version": "0.0.1",
    "description": "Sensible API for {one-line description of what this spec covers}.",
    // License is a placeholder — do not change.
    "license": {
      "name": "Sensible API",
      "url": "https://www.TBD.org/licenses/LICENSE-2.0.html"
    }
  },

  // Global security — applies to every operation. Always bearer auth. Do not override per-operation.
  "security": [
    { "bearerAuth": [] }
  ],

  // One tag per logical grouping of endpoints. Put the detailed description here, not on
  // individual operations — readme.io renders the tag description as the group intro.
  "tags": [
    {
      "name": "{Resource name}",
      "description": "{Multi-sentence description of the resource and what you can do with it.}"
    }
  ],

  "paths": {

    // Collection route: list + create
    "/{resources}": {
      "get": {
        // operationId: kebab-case verb-noun. Verbs: list, get, create, update, upsert, delete.
        "operationId": "list-{resources}",
        "summary": "List {resources}",
        "description": "{One sentence. What does this return? Any filtering or pagination to note?}",
        "tags": ["{Resource name}"],
        "responses": {
          "200": {
            "description": "{What is returned}",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/{ResourceOutput}" }
                },
                // Inline example on the response when the list shape is the clearest demo.
                // For complex request bodies, use "examples" (plural) on the requestBody instead.
                "example": []
              }
            }
          },
          "400": { "$ref": "#/components/responses/400" },
          "401": { "$ref": "#/components/responses/401" },
          // Add 403 only when there is a specific condition that returns it (e.g. missing account alias).
          // Add 415 when the endpoint requires Content-Type: application/json.
          "500": { "$ref": "#/components/responses/500" }
        }
      },

      // Use POST for create-only (server assigns the ID).
      // Use PUT on /{resources}/{name} for upsert (client supplies the name). See below.
      "post": {
        "operationId": "create-{resource}",
        "summary": "Create {resource}",
        "description": "{What does this create? Any constraints on the input?}",
        "tags": ["{Resource name}"],
        "requestBody": {
          // Always true for POST and PUT.
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/{ResourceInput}" },
              // Use "example" (singular, inline) for a single representative value.
              // Use "examples" (plural, named map) when showing multiple distinct cases.
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "{What is returned}",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/{ResourceOutput}" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/400" },
          "401": { "$ref": "#/components/responses/401" },
          "409": {
            // Use 409 for create-only endpoints where the resource already exists.
            // Omit for upsert (PUT) endpoints.
            "$ref": "#/components/responses/409"
          },
          "500": { "$ref": "#/components/responses/500" }
        }
      }
    },

    // Item route: get + upsert + delete by name/ID
    "/{resources}/{name}": {
      // Shared parameters go here, not on each operation — avoids repetition.
      "parameters": [
        { "$ref": "#/components/parameters/{resourceName}" }
      ],

      "get": {
        "operationId": "get-{resource}",
        "summary": "Get {resource}",
        "description": "{One sentence.}",
        "tags": ["{Resource name}"],
        "responses": {
          "200": {
            "description": "{What is returned}",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/{ResourceOutput}" },
                "example": {}
              }
            }
          },
          "400": { "$ref": "#/components/responses/400" },
          "401": { "$ref": "#/components/responses/401" },
          // Include 404 on all item routes (get, put, delete).
          "404": { "$ref": "#/components/responses/404" },
          "500": { "$ref": "#/components/responses/500" }
        }
      },

      // PUT = upsert (create-or-update). Client owns the name; no 409.
      "put": {
        "operationId": "upsert-{resource}",
        "summary": "Create or update {resource}",
        "description": "{What does this create or update? What fields can be replaced on update? What cannot change after creation?}",
        "tags": ["{Resource name}"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/{ResourceInput}" },
              // Use named "examples" for upsert when create and update cases differ meaningfully.
              "examples": {
                "{scenario label}": {
                  "value": {}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{What is returned}",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/{ResourceOutput}" },
                "example": {}
              }
            }
          },
          "400": { "$ref": "#/components/responses/400" },
          "401": { "$ref": "#/components/responses/401" },
          "404": { "$ref": "#/components/responses/404" },
          "500": { "$ref": "#/components/responses/500" }
        }
      },

      "delete": {
        "operationId": "delete-{resource}",
        "summary": "Delete {resource}",
        "description": "{One sentence. Is delete idempotent? What side effects does it have?}",
        "tags": ["{Resource name}"],
        "responses": {
          // DELETE returns 204 — no body. Use the shared $ref, not an inline response.
          "204": { "description": "{Resource} deleted" },
          "400": { "$ref": "#/components/responses/400" },
          "401": { "$ref": "#/components/responses/401" },
          "404": { "$ref": "#/components/responses/404" },
          "500": { "$ref": "#/components/responses/500" }
        }
      }
    }
  },

  "components": {
    "schemas": {

      // Input schema: what the client sends in the request body.
      // additionalProperties: false — always, to reject unknown fields.
      // required: [...] — list required fields here, not inline on each property.
      "{ResourceInput}": {
        "description": "{One sentence describing the input object.}",
        "type": "object",
        "required": ["{requiredField}"],
        "additionalProperties": false,
        "properties": {
          "{requiredField}": {
            // Lead descriptions with what it does: "Specifies...", "The name of...", "Controls..."
            // Not "This field..." or "Use this to..."
            "type": "string",
            "description": "{Specifies ...}"
          },
          "{optionalField}": {
            "type": "string",
            "description": "{Specifies ...}"
          },
          // For a property that is a $ref but also needs its own description, use allOf.
          // Without allOf, you cannot add a description alongside a $ref.
          "{refWithDescription}": {
            "description": "{Property-level description.}",
            "allOf": [{ "$ref": "#/components/schemas/{SharedSchema}" }]
          },
          // For a param that exists in the backend but is deliberately not public:
          // remove the property entirely and add x-internal-note on the parent schema instead.
          // "x-internal-note": "{fieldName} is accepted by the backend (file:lines) but deliberately not documented publicly."
        }
      },

      // Output schema: what the API returns.
      // No additionalProperties: false — output can evolve without breaking clients.
      "{ResourceOutput}": {
        "description": "{One sentence describing the output object.}",
        "type": "object",
        "required": ["{alwaysPresentField}"],
        "properties": {
          "{alwaysPresentField}": {
            "type": "string",
            "description": "{Specifies ...}"
          },
          "{timestampField}": {
            "type": "string",
            // Use format: date-time for ISO 8601 timestamps.
            "format": "date-time",
            "description": "The ISO 8601 timestamp when Sensible {created/updated} the {resource}."
          },
          "{optionalOutputField}": {
            "type": "string",
            "description": "{How Sensible ... if configured.}"
          }
        }
      },

      // Discriminated union: use oneOf + discriminator when a field can be one of several shapes.
      // The discriminator.propertyName must appear in every variant's required array.
      "{UnionSchema}": {
        "description": "{What this union represents.}",
        "oneOf": [
          { "$ref": "#/components/schemas/{VariantA}" },
          { "$ref": "#/components/schemas/{VariantB}" }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "variantA": "#/components/schemas/{VariantA}",
            "variantB": "#/components/schemas/{VariantB}"
          }
        }
      },

      "{VariantA}": {
        "description": "{What this variant does.}",
        "type": "object",
        "required": ["kind"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["variantA"]
          }
        }
      }
    },

    "parameters": {
      // Path parameter definition. Reuse via $ref on the path object, not on each operation.
      "{resourceName}": {
        "name": "{name}",
        "in": "path",
        "required": true,
        "description": "{What is this parameter? Any format constraints?}",
        "schema": {
          "type": "string",
          // Add a pattern when the API enforces a format (e.g. lowercase + underscores).
          "pattern": "^[a-z0-9_]+$"
        }
      }
    },

    "responses": {
      // Standard error responses — copy verbatim. Only add error codes that this API actually returns.
      // 400, 401, 500 appear on every endpoint.
      // 403: use when a specific condition (not just auth) blocks the request.
      // 404: use on all item routes (get/put/delete by ID or name).
      // 409: use for create-only endpoints where duplicate name/ID is rejected.
      // 415: use when the endpoint requires a specific Content-Type.
      // 429: use when the endpoint is rate-limited.
      "400": {
        "description": "Bad Request",
        "content": {
          "text/plain": {
            "schema": {
              "title": "Bad Request",
              "type": "string",
              // Use a realistic example that reflects an actual error message from the backend.
              "example": "{Example error message for this resource}"
            }
          }
        }
      },
      "401": {
        "description": "Not authorized",
        "content": {
          "text/plain": {
            "schema": { "title": "Unauthorized", "type": "string", "example": "Unauthorized" }
          }
        }
      },
      "403": {
        "description": "Forbidden",
        "content": {
          "text/plain": {
            "schema": { "title": "Forbidden", "type": "string", "example": "{Example 403 message}" }
          }
        }
      },
      "404": {
        "description": "Not Found",
        "content": {
          "text/plain": {
            "schema": { "title": "Not Found", "type": "string" }
          }
        }
      },
      "409": {
        "description": "Conflict",
        "content": {
          "text/plain": {
            "schema": { "title": "Conflict", "type": "string", "example": "{Example 409 message}" }
          }
        }
      },
      "415": {
        "description": "Unsupported Media Type",
        "content": {
          "text/plain": {
            "schema": { "title": "Unsupported Media Type", "type": "string" }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "text/plain": {
            "schema": {
              "title": "Sensible encountered an unknown error",
              "type": "string",
              "example": "Sensible encountered an unknown error"
            }
          }
        }
      }
    },

    "securitySchemes": {
      // Do not change this block — it is identical across all specs.
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sensible uses API keys to authenticate requests. Keep your API keys secure and do not share them in publicly accessible areas such as GitHub or client-side code. Authenticate using Bearer Authentication by providing your API key as the bearer token value."
      }
    }
  }
}
